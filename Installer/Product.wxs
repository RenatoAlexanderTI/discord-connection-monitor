<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Discord Monitor"
           Language="3082"
           Version="1.0.0.0"
           Manufacturer="DiscordMonitor"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser"
             Description="Monitorea tu conexion durante llamadas de Discord" />

    <MajorUpgrade DowngradeErrorMessage="Ya esta instalada una version mas nueva." />
    <MediaTemplate EmbedCab="yes" />

    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="DiscordMonitor" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Discord Monitor" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
        <RegistryValue Root="HKCU"
                       Key="Software\DiscordMonitor"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />

        <RegistryValue Root="HKCU"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="DiscordMonitor"
                       Type="string"
                       Value="[INSTALLFOLDER]DiscordMonitor.exe" />

        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="CleanupStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="AppFiles" Guid="D3E4F5A6-B7C8-9012-DEF0-234567890123">
        <RegistryValue Root="HKCU"
                       Key="Software\DiscordMonitor"
                       Name="files"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <File Id="DiscordMonitorEXE" Source="..\publish\DiscordMonitor.exe" />
        <File Id="DiscordMonitorDLL" Source="..\publish\DiscordMonitor.dll" />
        <File Id="DiscordMonitorDeps" Source="..\publish\DiscordMonitor.deps.json" />
        <File Id="DiscordMonitorConfig" Source="..\publish\DiscordMonitor.runtimeconfig.json" />
        <File Id="SystemSpeech" Source="..\publish\System.Speech.dll" />
      </Component>

      <Directory Id="RuntimesFolder" Name="runtimes">
        <Directory Id="WinFolder" Name="win">
          <Directory Id="LibFolder" Name="lib">
            <Directory Id="Net80Folder" Name="net8.0">
              <Component Id="RuntimeSpeech" Guid="E4F5A6B7-C8D9-0123-EF01-345678901234">
                <RegistryValue Root="HKCU"
                               Key="Software\DiscordMonitor"
                               Name="runtime"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
                <File Id="SystemSpeechRuntime" Source="..\publish\runtimes\win\lib\net8.0\System.Speech.dll" />
                <RemoveFolder Id="RemoveNet80" Directory="Net80Folder" On="uninstall" />
                <RemoveFolder Id="RemoveLib" Directory="LibFolder" On="uninstall" />
                <RemoveFolder Id="RemoveWin" Directory="WinFolder" On="uninstall" />
                <RemoveFolder Id="RemoveRuntimes" Directory="RuntimesFolder" On="uninstall" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>

      <Component Id="StartMenuShortcut" Guid="C2D3E4F5-A6B7-8901-CDEF-123456789012">
        <Shortcut Id="StartMenuShortcut"
                  Name="Discord Monitor"
                  Directory="ApplicationProgramsFolder"
                  Target="[INSTALLFOLDER]DiscordMonitor.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <RegistryValue Root="HKCU"
                       Key="Software\DiscordMonitor"
                       Name="shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />

        <RemoveFolder Id="RemoveMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="Discord Monitor" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppFiles" />
      <ComponentRef Id="RuntimeSpeech" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Product>
</Wix>