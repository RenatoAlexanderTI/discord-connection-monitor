<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Discord Monitor"
           Language="3082"
           Version="1.0.0.0"
           Manufacturer="DiscordMonitor"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser"
             Description="Monitorea tu conexión durante llamadas de Discord"
             Comments="Overlay liviano para Windows" />

    <MajorUpgrade DowngradeErrorMessage="Ya está instalada una versión más nueva de Discord Monitor." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ── Iconos y UI del installer ───────────────────────────────── -->
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ── Propiedades ─────────────────────────────────────────────── -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="AUTOSTART" Value="1" />

    <!-- ── Estructura de directorios ───────────────────────────────── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="DiscordMonitor" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Discord Monitor" />
      </Directory>
    </Directory>

    <!-- ── Componentes ─────────────────────────────────────────────── -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
        <File Id="DiscordMonitorEXE"
              Source="..\publish\DiscordMonitor.exe"
              KeyPath="yes" />

        <!-- Acceso directo en Inicio -->
        <Shortcut Id="StartMenuShortcut"
                  Name="Discord Monitor"
                  Directory="ApplicationProgramsFolder"
                  Advertise="no"
                  Icon="AppIcon"
                  IconIndex="0" />

        <!-- Inicio automático con Windows (HKCU, no requiere admin) -->
        <RegistryValue Root="HKCU"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="DiscordMonitor"
                       Type="string"
                       Value="[INSTALLFOLDER]DiscordMonitor.exe"
                       KeyPath="no" />

        <!-- Clave de desinstalación -->
        <RemoveFolder Id="CleanupStartMenu"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- ── Feature ─────────────────────────────────────────────────── -->
    <Feature Id="ProductFeature" Title="Discord Monitor" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>

    <!-- ── Icono ───────────────────────────────────────────────────── -->
    <Icon Id="AppIcon" SourceFile="..\..\DiscordMonitor\icon.ico" />

    <!-- ── Acción: pedir permiso de inicio automático al terminar ──── -->
    <CustomAction Id="LaunchAfterInstall"
                  FileKey="DiscordMonitorEXE"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchAfterInstall" After="InstallFinalize">
        NOT Installed AND NOT REMOVE
      </Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
